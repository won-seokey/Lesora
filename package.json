{
  "name": "lesora",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "scripts": {
    "dev:web": "node --env-file-if-exists=.env node_modules/next/dist/bin/next dev apps/web --hostname 127.0.0.1",
    "dev:api": "node --env-file-if-exists=.env --watch apps/api/src/index.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "build": "npm run build --workspaces --if-present",
    "check": "npm test && npm run test:api && npm run typecheck && npm run lint && npm run build",
    "test:api": "node --test tests/integration/*.test.ts"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0"
  }
}
