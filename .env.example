# No paid services are enabled by default.
PORT=4000
HOST=127.0.0.1
APP_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:4000
POC_ENABLED=false
# Generate two DIFFERENT values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POC_TEACHER_KEY=
POC_STUDENT_KEY=
POC_ROOM=lesora-poc
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
ZOOM_VIDEO_SDK_KEY=
ZOOM_VIDEO_SDK_SECRET=
# Used by Compose DB only; Phase 0 API does not persist data yet.
POSTGRES_PASSWORD=local-development-only
# Optional Zoom isolation experiment: off | require-corp
ZOOM_COEP=off
